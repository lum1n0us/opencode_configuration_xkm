{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1048576, "output": 384000 },
          "settings": {
            "temperature": 0.12,
            "topP": 0.75,
            "maxTokens": 8192,
            "frequency_penalty": 0.1,
            "presence_penalty": 0.1
          }
        },
        "deepseek-v4-pro": {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1048576, "output": 384000 },
          "settings": {
            "temperature": 0.08,
            "topP": 0.7,
            "maxTokens": 32768,
            "frequency_penalty": 0.05,
            "presence_penalty": 0.05
          }
        }
      }
    }
  },
  "model": "github-copilot/gpt-5.6-terra",
  "small_model": "github-copilot/gpt-5.6-luna",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "github-copilot/gpt-5.6-terra",
      "temperature": 0.08,
      "permission": {
        "edit": "allow"
      }
    },
    "plan": {
      "model": "github-copilot/gpt-5.6-sol",
      "temperature": 0.05,
      "permission": {
        "edit": "deny"
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      ".env*": "deny",
      "**/.env*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      ".ssh/**": "deny",
      "**/.ssh/**": "deny",
      "**/*.{pem,key,p12,pfx}": "deny",
      ".aws/**": "deny",
      "**/.aws/**": "deny",
      ".kube/**": "deny",
      "**/.kube/**": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "which *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npm run typecheck*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "pnpm run lint*": "allow",
      "pnpm run build*": "allow",
      "pnpm run typecheck*": "allow",
      "yarn test*": "allow",
      "yarn lint*": "allow",
      "yarn build*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "bun run lint*": "allow",
      "bun run build*": "allow",
      "pytest*": "allow",
      "ruff check*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "go test*": "allow",
      "go vet*": "allow",
      "make test*": "allow",
      "make lint*": "allow",
      "make build*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  },
  "share": "disabled",
  "compaction": {
    "prune": true
  },
  "tool_output": {
    "max_lines": 5,
    "max_bytes": 2048
  }
}
